# Copy to .env and fill in. NEVER commit the real .env.

# ── Core ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000          # public base URL; used in emails, CORS, links
TRUST_PROXY=                            # set to 1 behind CloudFront/ALB in production
FORCE_HTTP=true                         # dev only: serve plain HTTP. Never set in production.

# ── Observability ──────────────────────────────────────
LOG_LEVEL=info                          # pino level: trace|debug|info|warn|error|silent
SENTRY_DSN=                             # error monitoring; left blank = disabled

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=                             # REQUIRED. openssl rand -hex 48
JWT_REFRESH_SECRET=                     # separate key for refresh tokens. openssl rand -hex 48
JWT_EXPIRES_IN=1h
JWT_2FA_EXPIRES_IN=5m
# DEMO_2FA_CODE is dev-only and ignored in production

# ── Storage (files) ────────────────────────────────────
STORAGE_DRIVER=disk                     # disk (default) or s3
S3_BUCKET=
AWS_REGION=us-east-1
# S3_KMS_KEY_ID=                        # optional: enables SSE-KMS instead of AES256

# Encryption at rest for the 'disk' driver (AES-256-GCM). Leave blank to store
# files unencrypted. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: back this up — losing/rotating it makes existing files unreadable.
# FILE_ENCRYPTION_KEY=

# ── Malware scanning (ClamAV) ──────────────────────────
AV_ENABLED=false                        # true to scan uploads via clamd (needs ClamAV installed)
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
# CLAMD_SOCKET=/var/run/clamav/clamd.ctl   # use a unix socket instead of host/port
# AV_FAIL_OPEN=false                    # if true, allow uploads when the scanner is unreachable

# ── Email (SMTP / SES) ─────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=                               # where alerts/contact submissions go

# ── Stripe (optional) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# ── Web push (optional) ────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
