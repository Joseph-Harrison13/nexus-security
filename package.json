{
  "name": "nexus-security",
  "version": "1.0.0",
  "description": "Multi-tenant encrypted file storage with mandatory 2FA, per-organization scoping and an audit trail.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "audit": "npm audit --omit=dev",
    "setup": "git config core.hooksPath .githooks && echo 'pre-push hook enabled'"
  },
  "keywords": [
    "security",
    "multi-tenant",
    "encryption",
    "2fa",
    "file-storage"
  ],
  "author": "Joseph Harrison",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.62.0",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "clamscan": "^2.4.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "file-type": "^22.0.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "stripe": "^22.3.0",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  }
}
